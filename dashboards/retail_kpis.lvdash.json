{
  "datasets": [
    {
      "name": "ds_sales",
      "displayName": "Sales (metric view)",
      "asset_name": "retail.semantic.sales_metrics"
    },
    {
      "name": "ds_returns",
      "displayName": "Returns (metric view)",
      "asset_name": "retail.semantic.returns_metrics"
    },
    {
      "name": "ds_return_cohort_maturity",
      "displayName": "Return rate by order month, with cohort maturity",
      "queryLines": [
        "SELECT order_month,\n",
        "       MEASURE(return_rate) AS return_rate,\n",
        "       CASE WHEN datediff(DATE'2026-09-14', last_day(order_month)) >= 30\n",
        "            THEN 'closed' ELSE 'still open' END AS return_window\n",
        "FROM retail.semantic.sales_metrics\n",
        "GROUP BY order_month"
      ]
    },
    {
      "name": "ds_data_issues",
      "displayName": "Data issues by feed, batch and rule",
      "queryLines": [
        "SELECT feed, batch_id, issue, handling, `rows`\n",
        "FROM retail.dq.issue_summary"
      ]
    }
  ],
